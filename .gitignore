# =============================================================================
# Everything here is REGENERATED by the build step in run.sh on first launch
# (~10 min). The repo holds the code, the generators, and the hand-authored
# source descriptions; the machine-generated tables, the index, and all data
# are rebuilt locally.
# =============================================================================

# --- machine-generated per-table leaves (rebuilt by tools/gen_*.py) ------------------
# Each dir's _access.md description IS committed; only the generated leaves are ignored.
# (BigQuery leaves and hand-authored sources — irs-grants, fema, nih, nsf, grants-gov,
#  usaspending, college-scorecard, nonprofit-bmf, nonprofit-profile — are kept.)
sources/sec-edgar/*.md
sources/census/*.md
sources/treasury/*.md
sources/cdc-places/*.md
sources/nonprofit-990/*.md
!sources/**/_access.md

# --- compiled ARD index cache (rebuilt: `python registry/index.py build`) ------------
# vectors.npy is 100MB+ (over GitHub's file limit); meta.json is its derived companion.
registry/vectors.npy
registry/meta.json
registry/builds/
registry/current
registry/current.tmp

# --- other caches / derived data -----------------------------------------------------
resolver_cache.json
data/
cache/

# --- secrets (API keys live OUTSIDE the repo; never commit) --------------------------
set_keys.sh*
set_keys*.local
.env
*.key

# --- python / os ---------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
.DS_Store
*.swp

# test run outputs
tests/results.json
dist/

# --- ARD corpus: never committed to NeuralKG -------------------------------------------
# The engine holds no knowledge of any particular source, so the corpus is an INPUT, not
# part of the code. Keeping it out is what lets this be pointed at a different ARD without
# a code change -- tests/test_query_understanding_isolation.py enforces the same rule in
# the prompts. These paths stay on disk and are used at runtime; they are simply not ours
# to version here.
sources/
corpora/
catalog/
tools/descriptions_cache.json
tools/repr_queries_cache.json
tools/descriptions_input.json
